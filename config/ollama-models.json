{
  "$schema": "./schemas/ollama-models.schema.json",
  "llm": {
    "strategy": "fallback",
    "providers": [
      {
        "type": "ollama-local",
        "model": "ministral-3:3b",
        "url": "http://localhost:11434",
        "label": "Local Ollama — Ministral 3B (RAM-safe default)",
        "timeout_ms": 120000,
        "health_check": true,
        "health_timeout_ms": 2000
      },
      {
        "type": "ollama-cloud",
        "model": "mistral:latest",
        "url": "https://api.ollama.com",
        "label": "Ollama Cloud — Mistral",
        "timeout_ms": 60000,
        "health_check": true,
        "health_timeout_ms": 3000
      },
      {
        "type": "mistral",
        "model": "mistral-small-latest",
        "api_key_env": "MISTRAL_API_KEY",
        "label": "Mistral AI API — mistral-small (cloud fallback)",
        "timeout_ms": 30000,
        "health_check": true
      }
    ]
  },
  "embedding": {
    "strategy": "fallback",
    "providers": [
      {
        "type": "ollama-local",
        "model": "nomic-embed-text-v2-moe:latest",
        "url": "http://localhost:11434",
        "label": "Local Ollama — Nomic v2 MoE",
        "timeout_ms": 30000,
        "health_check": true,
        "health_timeout_ms": 2000
      },
      {
        "type": "ollama-cloud",
        "model": "nomic-embed-text-v2-moe:latest",
        "url": "https://api.ollama.com",
        "label": "Ollama Cloud — Nomic v2 MoE",
        "timeout_ms": 30000,
        "health_check": true,
        "health_timeout_ms": 3000
      },
      {
        "type": "mistral",
        "model": "mistral-embed",
        "api_key_env": "MISTRAL_API_KEY",
        "label": "Mistral AI API — mistral-embed (cloud fallback)",
        "timeout_ms": 30000,
        "health_check": true
      }
    ]
  },
  "health": {
    "enabled": true,
    "cache_ttl_s": 60,
    "retry_backoff_s": 30
  }
}
