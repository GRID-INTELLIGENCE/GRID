# GRID-main Environment Variables
# Copy to .env and fill in values

# GRID API
GRID_API_URL=http://localhost:8080

# Database
DATABASE_URL=sqlite:///mothership.db

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ministral-3:3b

# Mistral AI (Primary external provider)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# OpenAI (Legacy/fallback external provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Secondary external provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Paths
CASCADE_WORKSPACE_ROOT=/home/caraxes/CascadeProjects
GATE_DIR=/home/caraxes/CascadeProjects/Projects/GATE

# Security
SECRET_KEY=change-me-in-production
